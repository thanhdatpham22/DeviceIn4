<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#151D30">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="DEVICEIN4" android:textColor="#5FE1D5"
        android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_metric" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RAM"
        android:textColor="#99A9BD" android:textSize="12sp" />
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—"
        android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp"
        android:max="100" android:progress="0" />
</LinearLayout>
